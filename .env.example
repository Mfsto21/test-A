# Hosted Postgres (e.g. Neon). Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (unpooled) connection to the same database — used only for schema
# pushes/migrations. For Neon, this is the same URL with "-pooler" removed
# from the hostname.
DIRECT_URL="postgresql://user:password@your-endpoint.region.aws.neon.tech/dbname?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"
# Vercel Blob storage — required in any deployed environment so uploaded
# photos/plans/videos persist (Vercel's serverless functions can't write to
# the local filesystem). Get this from the Vercel dashboard: Storage tab ->
# Create Database -> Blob -> Connect to Project (auto-fills this var there).
# Leave unset for local dev — uploads fall back to public/uploads on disk.
BLOB_READ_WRITE_TOKEN=""
